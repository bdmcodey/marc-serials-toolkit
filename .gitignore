# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets / environment
.env
*.env
!.env.example

# The per-session file store, if it is ever pointed inside the repository.
# By default it lives in the system temp directory; see marc_serials/store.py.
marc_uploads/
.marc_uploads/
uploads/

# Real / working MARC data — keep only the synthetic samples in data/.
# Both are generated by scripts/ and contain only invented titles, so no
# library's holdings ever reach the repository.
*.mrc
*.mrk
!data/example_holdings.mrc
!data/messy_holdings.mrc

# Scratch notes written to orient a new working session and thrown away once
# they have. The durable record is CORPUS-FINDINGS.md, the tagged corpus and
# the test suite, all of which are maintained rather than snapshotted.
HANDOFF.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
