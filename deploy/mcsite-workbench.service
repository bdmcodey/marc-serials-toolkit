[Unit]
Description=MARC Serials Toolkit — Holdings Workbench (gunicorn)
After=network.target

[Service]
User=youruser
Group=www-data
WorkingDirectory=/home/youruser/marc-serials-toolkit/workbench
# Replace with a real random value: python3 -c "import secrets;print(secrets.token_hex(32))"
Environment=SECRET_KEY=CHANGE_ME_RANDOM_HEX
ExecStart=/home/youruser/marc-serials-toolkit/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8003 app:app
Restart=always

[Install]
WantedBy=multi-user.target
